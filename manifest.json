{
  "name": "Route Lens",
  "short_name": "Route Lens",
  "description": "Plan a route, then travel it as the solar system, an atom, or any journey you like.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12121f",
  "theme_color": "#12121f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Route from here",
      "short_name": "From here",
      "description": "Set your current location as the start point",
      "url": "./index.html?action=start-here"
    },
    {
      "name": "Set destination",
      "short_name": "Destination",
      "description": "Arm the map to set an end point",
      "url": "./index.html?action=set-end"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
